/* app.wxss —— 全局样式 */
page {
  background: #f5f6f8;
  color: #1c1f26;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  color: #5b6068;
}

.muted {
  font-size: 24rpx;
  color: #8a8f99;
}

.money {
  color: #ff6a00;
  font-weight: 700;
}

.big-money {
  font-size: 44rpx;
  color: #ff6a00;
  font-weight: 700;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #eef3ff;
  color: #3b6ef6;
}

.tag-green {
  background: #e8f7ee;
  color: #1f9d55;
}

.tag-amber {
  background: #fff4e5;
  color: #c26a00;
}

.tag-gray {
  background: #f2f3f5;
  color: #8a8f99;
}

.divider {
  height: 1rpx;
  background: #f0f1f3;
  margin: 24rpx 0;
}

.btn-primary {
  background: #1f9d55;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #fff;
  color: #1f9d55;
  border: 1rpx solid #1f9d55;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

.btn-disabled {
  background: #e6e8eb !important;
  color: #a9aeb5 !important;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #a9aeb5;
  font-size: 26rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
