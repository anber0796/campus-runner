<view class="container">

  <view class="error-card" wx:if="{{error}}">{{error}}</view>

  <view class="wallet-top">
    <view class="wallet-label">可提现</view>
    <view class="wallet-amount">¥{{available}}</view>
    <view class="wallet-sub">待结算 ¥{{pending}} · 累计 ¥{{settled}}</view>
    <view class="wallet-hint" wx:if="{{pending !== '0.00'}}">待结算的钱，送达满 24 小时后自动变成可提现</view>
    <view class="wallet-btn {{canWithdraw ? '' : 'disabled'}}" bindtap="withdraw">提现</view>
  </view>

  <view class="rule-tip">
    送达后 24 小时转入可提现（留一天处理"没收到/送错了"的争议）· 最低 10 元 · 每天 1 次
  </view>

  <view class="section-title">收支明细</view>

  <view class="card" wx:if="{{logs.length}}">
    <view class="log-item" wx:for="{{logs}}" wx:key="id">
      <view class="log-main">
        <view class="log-title">{{item.title}}</view>
        <view class="muted">{{item.timeText}} · {{item.statusText}}</view>
      </view>
      <view class="log-amount {{item.isWithdraw ? 'out' : ''}}">{{item.amountText}}</view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    还没有收入记录{{'\n'}}完成第一趟就有啦
  </view>

  <view class="empty" wx:elif="{{loading}}">加载中…</view>

</view>
