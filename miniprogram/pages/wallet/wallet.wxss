.wallet-top {
  position: relative;
  background: linear-gradient(135deg, #1f9d55 0%, #2bb96a 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 44rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.wallet-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.wallet-amount {
  font-size: 72rpx;
  font-weight: 700;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.wallet-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 8rpx;
}

.wallet-btn {
  position: absolute;
  right: 32rpx;
  bottom: 40rpx;
  background: #fff;
  color: #1f9d55;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 34rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
}

.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.log-item:last-child {
  border-bottom: none;
}

.log-title {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.log-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff6a00;
}

.tip-card {
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 1.9;
  padding: 8rpx 12rpx;
}
