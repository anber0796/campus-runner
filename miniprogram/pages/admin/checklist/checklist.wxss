.head { margin-bottom: 24rpx; }

.head-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mt8 { margin-top: 8rpx; }

.summary .stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
}

.stat-num.money { color: #ff6a00; }

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.btn-row {
  display: flex;
  margin-bottom: 8rpx;
}

.btn-ghost-line {
  flex: 1;
  text-align: center;
  line-height: 80rpx;
  border: 1rpx solid #1f9d55;
  color: #1f9d55;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
  background: #fff;
}

.btn-solid {
  flex: 1;
  text-align: center;
  line-height: 82rpx;
  background: #1f9d55;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-solid.disabled { background: #c9cdd4; }

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-id {
  font-size: 26rpx;
  color: #6b7280;
  font-family: Menlo, monospace;
}

.item-earn {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff6a00;
}

.item-meta {
  font-size: 27rpx;
  margin-top: 10rpx;
  color: #3d424a;
}

.rider-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  background: #f7fdf9;
  border-radius: 12rpx;
}

.rider-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.rider-phone {
  font-size: 26rpx;
  color: #3b6ef6;
}

.mark-btn {
  font-size: 25rpx;
  color: #fff;
  background: #1f9d55;
  padding: 0 28rpx;
  line-height: 80rpx;
  border-radius: 30rpx;
}

.mark-btn.disabled { background: #c9cdd4; }

.no-rider {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #c26a00;
  background: #fff8ee;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.tails {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tail {
  font-size: 24rpx;
  color: #3b6ef6;
  background: #eef3ff;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 10rpx 0;
}

.foot-tip {
  font-size: 22rpx;
  color: #6b7280;
  text-align: center;
  margin-top: 32rpx;
  line-height: 1.7;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
