.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
}

.logout {
  font-size: 24rpx;
  color: #8a8f99;
  padding: 8rpx 20rpx;
  border: 1rpx solid #e6e8eb;
  border-radius: 24rpx;
}

.stats {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-num.good { color: #1f9d55; }
.stat-num.warn { color: #e08a00; }

.stat-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 6rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8a8f99;
  margin: 32rpx 8rpx 12rpx;
}

.alert-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.alert-row:last-child { border-bottom: none; }

.alert-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.alert-dot.high { background: #d93b3b; }
.alert-dot.mid { background: #e08a00; }

.alert-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #3d424a;
}

.pack-title {
  font-size: 29rpx;
  font-weight: 600;
}

.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 16rpx; }

.republish {
  font-size: 24rpx;
  color: #1f9d55;
  border: 1rpx solid #1f9d55;
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
}

.empty-card {
  text-align: center;
  color: #a9aeb5;
  font-size: 25rpx;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
