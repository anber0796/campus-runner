.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.head-actions {
  display: flex;
  align-items: center;
}

.post-btn {
  font-size: 24rpx;
  color: #fff;
  background: #1f9d55;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
}

.logout {
  font-size: 24rpx;
  color: #6b7280;
  padding: 8rpx 20rpx;
  border: 1rpx solid #e6e8eb;
  border-radius: 24rpx;
}

.stats {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-num.good { color: #1f9d55; }
.stat-num.warn { color: #e08a00; }

.stat-label {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.row2 {
  display: flex;
  flex-wrap: wrap;
}

.mini {
  width: 50%;
  padding: 12rpx 0;
}

.mini-num {
  font-size: 34rpx;
  font-weight: 700;
}

.mini-num.warn { color: #d93b3b; }

.mini-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.tip-card {
  background: #fffdf7;
  border-left: 8rpx solid #f0a020;
  font-size: 25rpx;
  color: #3d424a;
  line-height: 1.7;
}

.tip-card.warn {
  background: #fdf3f3;
  border-left-color: #d93b3b;
}

.section-title {
  font-size: 26rpx;
  color: #6b7280;
  margin: 28rpx 8rpx 12rpx;
}

.alert-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.alert-row:last-child { border-bottom: none; }

.alert-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.alert-dot.high { background: #d93b3b; }
.alert-dot.mid { background: #e08a00; }

.alert-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-card {
  text-align: center;
  color: #6b7280;
  font-size: 25rpx;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 24rpx;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.payout-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6a00;
}

.payout-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 26rpx;
  padding: 0 32rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
}

.payout-btn.disabled {
  background: #c9cdd4;
}
