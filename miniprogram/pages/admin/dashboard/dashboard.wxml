<view class="container">

  <view class="head">
    <view>
      <view class="head-title">调度台</view>
      <view class="muted">{{username}} · 下拉刷新</view>
    </view>
    <view class="head-actions">
      <view class="post-btn" bindtap="goPost">发单</view>
      <view class="post-btn" bindtap="goChecklist">指派</view>
      <view class="logout" bindtap="logout">退出</view>
    </view>
  </view>

  <view class="error-card" wx:if="{{error}}">{{error}}</view>

  <block wx:if="{{stats}}">
    <view class="stats">
      <view class="stat">
        <view class="stat-num {{stats.draftCount ? 'warn' : ''}}">{{stats.draftCount}}</view>
        <view class="stat-label">待发单</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stats.pooledCount}}</view>
        <view class="stat-label">在池子里</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stats.counts.CLAIMED + stats.counts.PICKED + stats.counts.ASSIGNED}}</view>
        <view class="stat-label">进行中</view>
      </view>
      <view class="stat">
        <view class="stat-num good">{{stats.deliveredToday}}</view>
        <view class="stat-label">今日送达</view>
      </view>
    </view>

    <view class="card row2">
      <view class="mini">
        <view class="mini-num">¥{{stats.todayCost}}</view>
        <view class="mini-label">今日运力成本</view>
      </view>
      <view class="mini">
        <view class="mini-num {{stats.pooledOrders ? '' : 'warn'}}">{{stats.pooledOrders}}</view>
        <view class="mini-label">待抢订单</view>
      </view>
      <view class="mini">
        <view class="mini-num {{stats.noTaker ? 'warn' : ''}}">{{stats.noTaker}}</view>
        <view class="mini-label">超时无人抢</view>
      </view>
      <view class="mini">
        <view class="mini-num {{stats.staleClaims ? 'warn' : ''}}">{{stats.staleClaims}}</view>
        <view class="mini-label">抢了未取</view>
      </view>
    </view>

    <view class="card tip-card" wx:if="{{stats.draftCount}}">
      有 {{stats.draftCount}} 个批次还没定价，学生看不到。去「发单」把它们放出去。
    </view>
    <view class="card tip-card warn" wx:if="{{stats.noTaker}}">
      有 {{stats.noTaker}} 个批次过了抢单时间还没人接，考虑提价或改指派。
    </view>
    <view class="card tip-card warn" wx:if="{{stats.staleClaims}}">
      有 {{stats.staleClaims}} 个批次抢了 15 分钟没去取，系统会自动收回。
    </view>

    <view class="section-title">待打款</view>
    <view class="card payout-card">
      <view class="row-between">
        <view>
          <view class="payout-num">¥{{withdrawals.total}}</view>
          <view class="muted">{{withdrawals.count}} 笔提现申请待处理</view>
        </view>
        <view class="payout-btn {{withdrawals.count ? '' : 'disabled'}}" bindtap="payoutAll">标记已打款</view>
      </view>
    </view>

    <view class="section-title">待处理告警</view>
    <view class="card" wx:if="{{stats.alerts.length}}">
      <view class="alert-row" wx:for="{{stats.alerts}}" wx:key="id">
        <view class="alert-dot {{item.severity === 'high' ? 'high' : 'mid'}}"></view>
        <view class="alert-text">{{item.message}}</view>
      </view>
    </view>
    <view class="card empty-card" wx:else>暂无告警</view>

    <view class="foot-note">数据来自 batches 集合 · 每次下拉重新统计</view>
  </block>

  <view class="card empty-card" wx:elif="{{loading}}">加载中…</view>

</view>
