.head {
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 24rpx; }

.summary .stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
}

.stat-num.money { color: #ff6a00; }

.stat-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 6rpx;
}

.batch {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 600;
}

.breakdown {
  font-size: 23rpx;
  color: #8a8f99;
  margin-top: 14rpx;
}

.breakdown .dot {
  margin: 0 8rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 18rpx;
}

.yuan {
  font-size: 26rpx;
  color: #5b6068;
  margin-right: 6rpx;
}

.price-input {
  width: 110rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 14rpx 0;
}

.batch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f4f5f7;
  padding-top: 20rpx;
  margin-top: 20rpx;
}

.publish-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 27rpx;
  padding: 0 42rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
}

.publish-btn.disabled { background: #c9cdd4; }

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
