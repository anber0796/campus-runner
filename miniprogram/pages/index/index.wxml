<view class="container">

  <!-- 波次横幅：把决策从"现在有没有空"变成"等下反正要经过" -->
  <view class="wave-card" wx:if="{{wave}}">
    <view class="row-between">
      <view>
        <view class="wave-title">{{wave.tomorrow ? '明天' : '下一波'}} · {{wave.time}} 下课</view>
        <view class="wave-sub">{{wave.minutes}} 分钟后开推 · {{wave.main ? '主力波次' : '普通波次'}}</view>
      </view>
      <view class="wave-badge">{{wave.id}}</view>
    </view>
  </view>

  <!-- 认证未完成时的提示 -->
  <view class="card warn-card" wx:if="{{missing.length}}" bindtap="goRegister">
    <view class="row-between">
      <view>
        <view class="title">还差 {{missing.length}} 项完成认证</view>
        <view class="muted">{{missingText}}</view>
      </view>
      <view class="tag tag-amber">去认证</view>
    </view>
  </view>

  <!-- 顺路包列表 -->
  <block wx:if="{{packs.length}}">
    <view class="pack-card" wx:for="{{packs}}" wx:key="id" bindtap="openPack" data-id="{{item.id}}">
      <view class="row-between">
        <view class="pack-canteen">{{item.canteenName}}</view>
        <view class="tag tag-green">{{item.orderCount}} 单</view>
      </view>

      <view class="pack-caption">{{item.caption}}</view>

      <view class="pack-meta">
        <text>{{item.stallText}}</text>
        <text class="dot">·</text>
        <text>{{item.buildingName}} {{item.floorText}}</text>
      </view>

      <view class="divider"></view>

      <view class="row-between">
        <view class="row">
          <text class="big-money">{{item.incomeText}}</text>
          <text class="muted pack-eta">约 {{item.walkMinutes + 10}} 分钟</text>
        </view>
        <view class="take-btn">我要带</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:elif="{{!loading}}">
    这一波还没有顺路包{{'\n'}}下拉刷新试试
  </view>

</view>
