.wave-card {
  background: linear-gradient(135deg, #1f9d55 0%, #2bb96a 100%);
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.wave-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.wave-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 8rpx;
}

.wave-badge {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 28rpx;
  font-weight: 600;
}

.warn-card {
  border-left: 8rpx solid #f0a020;
}

.pack-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.pack-canteen {
  font-size: 30rpx;
  font-weight: 600;
}

.pack-caption {
  font-size: 28rpx;
  color: #3d424a;
  margin-top: 18rpx;
  line-height: 1.5;
}

.pack-meta {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 12rpx;
}

.pack-meta .dot {
  margin: 0 10rpx;
}

.pack-eta {
  margin-left: 16rpx;
}

.take-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 36rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
}
