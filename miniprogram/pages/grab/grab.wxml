<view class="container">

  <view class="head">
    <view>
      <view class="head-title">抢单大厅</view>
      <view class="muted" wx:if="{{student}}">
        {{student.name}} · 信用 {{student.credit}} · 今日 {{student.claimsToday}} 批 · 手上 {{student.activeClaims}} 批
      </view>
    </view>
    <view class="invite-btn" bindtap="goInvite">邀好友</view>
  </view>

  <view class="error-card" wx:if="{{error}}">{{error}}</view>

  <view class="card tip-card" wx:if="{{canClaim && !canClaim.ok}}">
    <view class="muted">当前不能抢单：{{canClaim.reason}}</view>
  </view>

  <block wx:if="{{batches.length}}">
    <view class="batch" wx:for="{{batches}}" wx:key="id">
      <view class="batch-head">
        <view class="batch-title">
          {{item.buildingText}} · {{item.floorRange}}
          <text class="cross" wx:if="{{item.crossBuilding}}">跨楼</text>
        </view>
        <view class="earn">{{item.earnText}}</view>
      </view>

      <view class="batch-meta">
        <text>{{item.orderCount}} 单</text>
        <text class="dot">·</text>
        <text>{{item.priceText}}</text>
        <text class="dot">·</text>
        <text>{{item.waveId}}</text>
      </view>

      <view class="tails">
        <text class="tail" wx:for="{{item.tails}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>

      <view class="batch-foot">
        <view class="muted">取完直接走，不用分拣</view>
        <view class="grab-btn" bindtap="grab" data-id="{{item.id}}">抢</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:elif="{{!loading}}">
    现在没有可抢的批次{{'\n'}}下课前 10 分钟会集中放单
  </view>

  <view class="empty" wx:elif="{{loading}}">加载中…</view>

</view>
