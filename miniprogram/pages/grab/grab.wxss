.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.invite-btn {
  font-size: 24rpx;
  color: #1f9d55;
  border: 1rpx solid #1f9d55;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}

.tip-card {
  background: #fffdf7;
  border-left: 8rpx solid #f0a020;
}

.batch {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 600;
}

.cross {
  font-size: 20rpx;
  color: #3b6ef6;
  background: #eef3ff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
}

.earn {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff6a00;
}

.batch-meta {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 12rpx;
}

.batch-meta .dot {
  margin: 0 10rpx;
}

.tails {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.tail {
  font-size: 24rpx;
  color: #3b6ef6;
  background: #eef3ff;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.batch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f4f5f7;
  padding-top: 20rpx;
  margin-top: 8rpx;
}

.grab-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 52rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
