.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 24rpx; }

.head-card { border-left: 8rpx solid #1f9d55; }

.earn {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff6a00;
}

.scan-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 26rpx;
  padding: 0 32rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.manual-input {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.ph { color: #c9cdd4; }

.manual-btn {
  margin-left: 16rpx;
  background: #1f9d55;
  color: #fff;
  font-size: 27rpx;
  padding: 0 36rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}

.manual-btn.disabled { background: #c9cdd4; }

.order-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.order-row:last-child { border-bottom: none; }

.tail-box {
  width: 104rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #eef3ff;
  color: #3b6ef6;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 10rpx;
}

.order-info {
  flex: 1;
  margin-left: 20rpx;
}

.order-stall {
  font-size: 27rpx;
  margin-bottom: 4rpx;
}

.state {
  font-size: 23rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.state.wait { background: #fff4e5; color: #c26a00; }
.state.picked { background: #eef3ff; color: #3b6ef6; }
.state.done { background: #e8f7ee; color: #1f9d55; }

.deliver-list { margin-top: 16rpx; }

.deliver-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.deliver-row:last-child { border-bottom: none; }

.tail-inline {
  color: #3b6ef6;
  font-weight: 600;
  margin-right: 16rpx;
}

.deliver-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  padding: 0 44rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 150rpx;
  text-align: center;
}

.deliver-btn.disabled { background: #c9cdd4; }

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.pick-order-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 140rpx;
  text-align: center;
}

.pick-order-btn.disabled { background: #c9cdd4; }

.mt8 { margin-top: 8rpx; }

/* 取餐动线 */
.route {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: #f7fdf9;
  border-radius: 12rpx;
}

.route-step {
  font-size: 24rpx;
  color: #1f9d55;
  font-weight: 600;
}

.route-step.done {
  color: #6b7280;
  text-decoration: line-through;
}

.route-arrow {
  font-size: 22rpx;
  color: #c9cdd4;
  margin: 0 12rpx;
}

/* 楼层分组 */
.floor-block {
  margin-top: 26rpx;
}

.floor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.floor-left {
  display: flex;
  align-items: center;
}

.floor-badge {
  width: 56rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #1f9d55;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 14rpx;
}

.floor-badge.done {
  background: #c9cdd4;
}

.floor-stalls {
  font-size: 26rpx;
  color: #3d424a;
}

.stall-name {
  flex: 1;
  font-size: 29rpx;
  font-weight: 500;
  color: #1c1f26;
}

.order-row.row-done .stall-name {
  color: #6b7280;
}

.tail-box {
  margin-right: 18rpx;
}

/* 下一站 */
.next-stop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #1f9d55 0%, #2bb96a 100%);
  border-radius: 16rpx;
  color: #fff;
}

.next-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.next-main {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.next-right {
  text-align: right;
}

.next-tail {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.next-remain {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.undo-btn {
  min-width: 140rpx;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #e08a00;
  color: #e08a00;
  font-size: 27rpx;
  font-weight: 600;
}
