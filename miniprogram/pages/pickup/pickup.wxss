.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 24rpx; }

.head-card { border-left: 8rpx solid #1f9d55; }

.earn {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff6a00;
}

.scan-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 26rpx;
  padding: 0 32rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.manual-input {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.ph { color: #c9cdd4; }

.manual-btn {
  margin-left: 16rpx;
  background: #1f9d55;
  color: #fff;
  font-size: 27rpx;
  padding: 0 36rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}

.manual-btn.disabled { background: #c9cdd4; }

.order-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.order-row:last-child { border-bottom: none; }

.tail-box {
  width: 104rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #eef3ff;
  color: #3b6ef6;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 10rpx;
}

.order-info {
  flex: 1;
  margin-left: 20rpx;
}

.order-stall {
  font-size: 27rpx;
  margin-bottom: 4rpx;
}

.state {
  font-size: 23rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.state.wait { background: #fff4e5; color: #c26a00; }
.state.picked { background: #eef3ff; color: #3b6ef6; }
.state.done { background: #e8f7ee; color: #1f9d55; }

.deliver-list { margin-top: 16rpx; }

.deliver-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.deliver-row:last-child { border-bottom: none; }

.tail-inline {
  color: #3b6ef6;
  font-weight: 600;
  margin-right: 16rpx;
}

.deliver-btn {
  background: #fff;
  color: #1f9d55;
  border: 1rpx solid #1f9d55;
  font-size: 25rpx;
  padding: 0 28rpx;
  line-height: 62rpx;
  border-radius: 31rpx;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.pick-order-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 32rpx;
  line-height: 62rpx;
  border-radius: 31rpx;
}

.pick-order-btn.disabled { background: #c9cdd4; }
