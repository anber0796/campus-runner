<view class="container">

  <view class="error-card" wx:if="{{error}}">{{error}}</view>

  <!-- 没有待取餐的批次 -->
  <view class="empty" wx:if="{{!batches.length && !loading}}">
    手上没有待取餐的批次{{'\n'}}去「可抢单」抢一单，或等运营指派
  </view>

  <!-- 多批次切换 -->
  <view class="tabs" wx:if="{{batches.length > 1}}">
    <view wx:for="{{batches}}" wx:key="id"
          class="tab {{current && current.id === item.id ? 'active' : ''}}"
          bindtap="selectBatch" data-id="{{item.id}}">
      {{item.canteenName}} · {{item.orderCount}}单
    </view>
  </view>

  <block wx:if="{{current}}">
    <view class="card head-card">
      <view class="row-between">
        <view>
          <view class="title">{{current.canteenName}}</view>
          <view class="muted mt8">{{current.orderCount}} 单 · 取齐后去送达</view>
        </view>
        <view class="earn">¥{{current.earn}}</view>
      </view>
    </view>

    <!-- 取餐：全部取齐后整块隐藏 -->
    <view class="card" wx:if="{{!allPicked}}">
      <view class="row-between">
        <view class="title">找商家取餐</view>
        <view class="scan-btn" bindtap="scan">扫码</view>
      </view>

      <!-- 下一站：把"我现在该去哪"直接写在屏幕上 -->
      <view class="next-stop" wx:if="{{nextStop}}">
        <view class="next-left">
          <view class="next-label">下一站</view>
          <view class="next-main">{{nextStop.floorLabel}} · {{nextStop.stallName}}</view>
        </view>
        <view class="next-right">
          <view class="next-tail">{{nextStop.tail}}</view>
          <view class="next-remain">还剩 {{nextStop.remain}} 单</view>
        </view>
      </view>

      <!-- 按楼层分组 -->
      <view class="floor-block" wx:for="{{groups}}" wx:key="floor" wx:for-item="g">
        <view class="floor-head">
          <view class="floor-left">
            <text class="floor-badge {{g.allDone ? 'done' : ''}}">{{g.floor}}F</text>
            <text class="floor-stalls">{{g.stallCount}} 家 · {{g.count}} 单</text>
          </view>
          <text class="muted">{{g.pickedCount}}/{{g.count}}</text>
        </view>

        <view class="order-row {{o.picked ? 'row-done' : ''}}" wx:for="{{g.orders}}" wx:key="id" wx:for-item="o">
          <view class="stall-name">{{o.stallName || '—'}}</view>
          <view class="tail-box">{{o.tail}}</view>

          <view wx:if="{{undoId === o.id}}" class="undo-btn" bindtap="undoPick" data-id="{{o.id}}">撤销</view>
          <view wx:elif="{{o.picked}}" class="state picked">已取</view>
          <view wx:else class="pick-order-btn {{busy ? 'disabled' : ''}}" bindtap="pickOrder" data-id="{{o.id}}">取餐</view>
        </view>
      </view>

      <!-- 扫码/手输兜底 -->
      <view class="divider"></view>
      <view class="manual-row">
        <input class="manual-input" placeholder="运单号（后 4 位也行）" placeholder-class="ph"
               value="{{inputNo}}" bindinput="onInputNo" confirm-type="done" bindconfirm="manualPickup" />
        <view class="manual-btn {{busy ? 'disabled' : ''}}" bindtap="manualPickup">确认</view>
      </view>
    </view>

    <!-- 取齐后：这里不再显示送达，只给一个入口 -->
    <view class="card done-card" wx:else>
      <view class="done-title">已取齐 {{current.orderCount}} 单</view>
      <view class="muted mt8">送去 {{current.buildingIds ? current.buildingIds.join(' + ') : current.buildingId}} · {{current.floorRange}}</view>
      <view class="done-tip">送达在单独的页面做，逐单拍照</view>
    </view>
  </block>

  <view class="empty" wx:elif="{{loading}}">加载中…</view>

  <!-- 底部固定主按钮 -->
  <view class="bottom-bar" wx:if="{{primary}}">
    <view class="bottom-info">
      <view class="bottom-label">{{primary.label}}</view>
      <view class="bottom-sub" wx:if="{{primary.sub}}">{{primary.sub}}</view>
    </view>
    <view class="bottom-btn {{busy ? 'disabled' : ''}}" bindtap="primaryTap">
      {{primary.kind === 'pick' ? '扫码' : '去送达'}}
    </view>
  </view>

</view>
