<view class="container">

  <view class="tabs">
    <view class="tab {{tab === 'active' ? 'active' : ''}}" bindtap="switchTab" data-tab="active">
      进行中 ({{active.length}})
    </view>
    <view class="tab {{tab === 'finished' ? 'active' : ''}}" bindtap="switchTab" data-tab="finished">
      已完成 ({{finished.length}})
    </view>
  </view>

  <block wx:if="{{tab === 'active'}}">
    <view class="card" wx:for="{{active}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
      <view class="row-between">
        <view class="title">{{item.canteenName}} · {{item.orderCount}} 单</view>
        <view class="tag tag-amber">{{item.statusText}}</view>
      </view>
      <view class="muted mt12">{{item.buildingName}} · 已取 {{item.pickedCount}}/{{item.orderCount}} 单</view>
      <view class="divider"></view>
      <view class="row-between">
        <text class="muted">{{item.timeText}}</text>
        <text class="money">{{item.incomeText}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!active.length && !loading}}">
      还没有进行中的单{{'\n'}}去「顺路包」接一单吧
    </view>
  </block>

  <block wx:else>
    <view class="card" wx:for="{{finished}}" wx:key="id">
      <view class="row-between">
        <view class="title">{{item.canteenName}} · {{item.orderCount}} 单</view>
        <view class="tag tag-green">已完成</view>
      </view>
      <view class="muted mt12">{{item.buildingName}} · {{item.timeText}}</view>
      <view class="divider"></view>
      <view class="row-between">
        <text class="muted">已计入待结算</text>
        <text class="money">{{item.incomeText}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!finished.length && !loading}}">还没有完成的单</view>
  </block>

</view>
