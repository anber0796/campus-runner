.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1f9d55 0%, #2bb96a 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  text-align: center;
  line-height: 108rpx;
  font-size: 44rpx;
  font-weight: 600;
}

.profile-main {
  margin-left: 26rpx;
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-tag {
  margin-left: 16rpx;
}

.profile-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

.cta-card {
  border-left: 8rpx solid #f0a020;
}
