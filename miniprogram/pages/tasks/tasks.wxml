<view class="container">

  <view class="error-card" wx:if="{{error}}">{{error}}</view>

  <view class="tabs">
    <view class="tab {{tab === 'active' ? 'active' : ''}}" bindtap="switchTab" data-tab="active">
      进行中 ({{active.length}})
    </view>
    <view class="tab {{tab === 'finished' ? 'active' : ''}}" bindtap="switchTab" data-tab="finished">
      已完成 ({{finished.length}})
    </view>
  </view>

  <block wx:if="{{tab === 'active'}}">
    <view class="task" wx:for="{{active}}" wx:key="id">
      <view class="task-head">
        <view class="task-title">{{item.buildingText}} · {{item.floorRange}}</view>
        <view class="{{item.statusClass}}">{{item.statusText}}</view>
      </view>

      <view class="task-meta">{{item.orderCount}} 单 · 到手 {{item.earnText}}</view>
      <view class="tails">
        <text class="tail" wx:for="{{item.tails}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>

      <view class="task-foot">
        <view class="muted">取齐直接走，不用分拣</view>
        <view class="go-btn" bindtap="goPickup" data-id="{{item.id}}">
          {{item.status === 'PICKED' ? '去送达' : '去取餐'}}
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!active.length && !loading}}">
      暂时没有指派给你的单{{'\n'}}下课前会集中分派
    </view>
  </block>

  <block wx:else>
    <view class="task" wx:for="{{finished}}" wx:key="id">
      <view class="task-head">
        <view class="task-title">{{item.buildingText}} · {{item.floorRange}}</view>
        <view class="tag tag-green">已完成</view>
      </view>
      <view class="task-meta">{{item.orderCount}} 单 · 到手 {{item.earnText}}</view>
      <view class="tails">
        <text class="tail" wx:for="{{item.tails}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!finished.length && !loading}}">还没有完成的单</view>
  </block>

  <view class="empty" wx:if="{{loading}}">加载中…</view>

</view>
