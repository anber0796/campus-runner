<view class="container">

  <!-- 没认证：直接引导 -->
  <view class="guide-card" wx:if="{{needCert}}">
    <view class="guide-title">先完成认证才能接单</view>
    <view class="guide-text">实名 + 学生证 + 健康证，约 3 分钟</view>
    <view class="guide-btn" bindtap="goRegister">去认证</view>
  </view>

  <!-- 报错：给重试 -->
  <view class="error-card" wx:if="{{error}}">
    <view class="error-text">{{error}}</view>
    <view class="retry-btn" wx:if="{{retryable}}" bindtap="retry">重试</view>
  </view>

  <!-- 首次进入引导 -->
  <view class="guide-card" wx:if="{{showGuide && tab === 'pool' && !needCert}}">
    <view class="guide-title">第一次用？三步就上手</view>
    <view class="guide-text">1. 抢一单 → 2. 去食堂按楼层取餐 → 3. 回宿舍拍照送达</view>
    <view class="guide-btn" bindtap="dismissGuide">知道了</view>
  </view>

  <view class="tabs3">
    <view class="tab3 {{tab === 'pool' ? 'active' : ''}}" bindtap="switchTab" data-tab="pool">
      可抢单<text class="num" wx:if="{{pool.length}}">{{pool.length}}</text>
    </view>
    <view class="tab3 {{tab === 'pick' ? 'active' : ''}}" bindtap="switchTab" data-tab="pick">
      待取餐<text class="num" wx:if="{{pick.length}}">{{pick.length}}</text>
    </view>
    <view class="tab3 {{tab === 'deliver' ? 'active' : ''}}" bindtap="switchTab" data-tab="deliver">
      待送达<text class="num" wx:if="{{deliver.length}}">{{deliver.length}}</text>
    </view>
    <view class="tab3 {{tab === 'done' ? 'active' : ''}}" bindtap="switchTab" data-tab="done">
      已完成<text class="num" wx:if="{{done.length}}">{{done.length}}</text>
    </view>
  </view>

  <!-- ============ 可抢单：取哪 + 送哪 + 剩多久 ============ -->
  <block wx:if="{{tab === 'pool'}}">
    <view class="card pool-tip" wx:if="{{student}}">
      {{student.name}} · 信用 {{student.credit}} · 今日已抢 {{student.claimsToday}} 批
    </view>

    <view class="task" wx:for="{{pool}}" wx:key="id">
      <view class="route-row">
        <text class="route-tag pick">取</text>
        <text class="route-main">{{item.canteenName}}</text>
        <text class="earn">{{item.earnText}}</text>
      </view>

      <view class="route-row">
        <text class="route-tag send">送</text>
        <text class="route-main">{{item.buildingText}} · {{item.floorRange}}</text>
      </view>

      <view class="pool-meta">
        <text>{{item.orderText}}</text>
        <text class="dot">·</text>
        <text>{{item.walkText}}</text>
        <text class="dot">·</text>
        <text class="{{item.urgent ? 'urgent' : ''}}">{{item.leftText}}</text>
      </view>

      <view class="task-foot">
        <view class="muted">取齐直接走，不用分拣</view>
        <view class="grab-btn {{busy ? 'disabled' : ''}}" bindtap="grab" data-id="{{item.id}}">抢</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!pool.length && !loading}}">
      暂时没有可抢的批次{{'\n'}}下课前会集中放单
    </view>
  </block>

  <!-- ============ 待取餐：食堂 + 商户（卡片内折叠） ============ -->
  <block wx:elif="{{tab === 'pick'}}">
    <view class="task" wx:for="{{pick}}" wx:key="id">
      <view class="task-head">
        <view>
          <view class="task-title">{{item.canteenName}}</view>
          <view class="task-sub">送至 {{item.buildingText}} · {{item.floorRange}}</view>
        </view>
        <view class="{{item.statusClass}}">{{item.statusText}}</view>
      </view>

      <view class="stall-list" wx:if="{{item.stallLines.length}}">
        <view class="stall-line" wx:for="{{item.stallLines}}" wx:for-item="s" wx:key="floor">
          <text class="floor-chip">{{s.floor}}F</text>
          <text class="stall-names">{{s.stallText}}</text>
          <text class="stall-count">{{s.count}} 单</text>
        </view>
        <view class="more-line" wx:if="{{item.stallMore}}">还有 {{item.stallMore}} 层，去取餐页看</view>
      </view>

      <view class="task-foot">
        <view class="muted">{{item.orderText}} · 到手 {{item.earnText}}</view>
        <view class="go-btn" bindtap="goPickup" data-id="{{item.id}}">去取餐</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!pick.length && !loading}}">
      没有待取餐的批次{{'\n'}}去「可抢单」抢一单，或等运营指派
    </view>
  </block>

  <!-- ============ 待送达：只显示送到哪栋哪层 ============ -->
  <block wx:elif="{{tab === 'deliver'}}">
    <view class="task" wx:for="{{deliver}}" wx:key="id">
      <view class="task-head">
        <view>
          <view class="task-title">{{item.buildingText}} · {{item.floorRange}}</view>
          <view class="task-sub">按楼层从上到下送</view>
        </view>
        <view class="{{item.statusClass}}">{{item.statusText}}</view>
      </view>

      <view class="task-foot">
        <view class="muted">{{item.orderText}} · 到手 {{item.earnText}}</view>
        <view class="go-btn" bindtap="goPickup" data-id="{{item.id}}">去送达</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!deliver.length && !loading}}">没有待送达的批次</view>
  </block>

  <!-- ============ 已完成：楼栋 + 单量 + 金额 ============ -->
  <block wx:else>
    <view class="task" wx:for="{{done}}" wx:key="id">
      <view class="task-head">
        <view class="task-title">{{item.buildingText}} · {{item.floorRange}}</view>
        <view class="tag tag-green">已完成</view>
      </view>

      <view class="done-meta">
        <text class="done-orders">{{item.orderCount}} 单</text>
        <text class="done-earn">{{item.earnText}}</text>
        <text class="muted done-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!done.length && !loading}}">
      还没有完成的单{{'\n'}}送完第一批就会出现在这里
    </view>
  </block>

  <view class="empty" wx:if="{{loading}}">加载中…</view>

</view>
