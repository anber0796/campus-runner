.task {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
}

.task-meta {
  font-size: 26rpx;
  color: #5b6068;
  margin-top: 12rpx;
}

.tails {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tail {
  font-size: 23rpx;
  color: #3b6ef6;
  background: #eef3ff;
  border-radius: 8rpx;
  padding: 5rpx 12rpx;
  margin: 0 10rpx 10rpx 0;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f4f5f7;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.go-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 27rpx;
  padding: 0 36rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
