.tabs3 {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab3 {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  font-size: 25rpx;
  color: #5b6068;
  border-radius: 12rpx;
  position: relative;
}

.tab3.active {
  background: #1f9d55;
  color: #fff;
  font-weight: 600;
}

.num {
  font-size: 20rpx;
  margin-left: 6rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
}

.tab3:not(.active) .num {
  background: #e8f7ee;
  color: #1f9d55;
}

.pool-tip {
  font-size: 24rpx;
  color: #6b7280;
  padding: 20rpx 24rpx;
}

.task {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
}

.earn {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff6a00;
}

.task-meta {
  font-size: 25rpx;
  color: #5b6068;
  margin-top: 12rpx;
}

.dot {
  margin: 0 10rpx;
  color: #c9cdd4;
}

.tails {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tail {
  font-size: 23rpx;
  color: #3b6ef6;
  background: #eef3ff;
  border-radius: 8rpx;
  padding: 5rpx 12rpx;
  margin: 0 10rpx 10rpx 0;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f4f5f7;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.grab-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 56rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 160rpx;
  text-align: center;
}

.grab-btn.disabled { background: #c9cdd4; }

.go-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 150rpx;
  text-align: center;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.mt8 { margin-top: 8rpx; }

.task-sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.urgent {
  color: #d93b3b;
  font-weight: 600;
}
