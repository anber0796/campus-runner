.tabs3 {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab3 {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  font-size: 25rpx;
  color: #5b6068;
  border-radius: 12rpx;
  position: relative;
}

.tab3.active {
  background: #1f9d55;
  color: #fff;
  font-weight: 600;
}

.num {
  font-size: 20rpx;
  margin-left: 6rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
}

.tab3:not(.active) .num {
  background: #e8f7ee;
  color: #1f9d55;
}

.pool-tip {
  font-size: 24rpx;
  color: #6b7280;
  padding: 20rpx 24rpx;
}

.task {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
}

.earn {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff6a00;
}

.task-meta {
  font-size: 25rpx;
  color: #5b6068;
  margin-top: 12rpx;
}

.dot {
  margin: 0 10rpx;
  color: #c9cdd4;
}

.tails {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tail {
  font-size: 23rpx;
  color: #3b6ef6;
  background: #eef3ff;
  border-radius: 8rpx;
  padding: 5rpx 12rpx;
  margin: 0 10rpx 10rpx 0;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f4f5f7;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.grab-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 56rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 160rpx;
  text-align: center;
}

.grab-btn.disabled { background: #c9cdd4; }

.go-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 150rpx;
  text-align: center;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.mt8 { margin-top: 8rpx; }

.task-sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.urgent {
  color: #d93b3b;
  font-weight: 600;
}

/* 引导卡片 */
.guide-card {
  background: #eef7ff;
  border-left: 8rpx solid #3b6ef6;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
}

.guide-text {
  font-size: 24rpx;
  color: #4a5058;
  margin-top: 10rpx;
  line-height: 1.7;
}

.guide-btn {
  display: inline-block;
  margin-top: 18rpx;
  background: #3b6ef6;
  color: #fff;
  font-size: 25rpx;
  padding: 0 32rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
}

/* 错误卡片带重试 */
.error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.error-text {
  flex: 1;
  font-size: 25rpx;
}

.retry-btn {
  margin-left: 20rpx;
  background: #fff;
  color: #d93b3b;
  border: 1rpx solid #d93b3b;
  font-size: 24rpx;
  padding: 0 26rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

/* ===== 可抢单：取/送 两行 ===== */
.route-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.route-tag {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.route-tag.pick {
  background: #fff4e5;
  color: #c26a00;
}

.route-tag.send {
  background: #eef3ff;
  color: #3b6ef6;
}

.route-main {
  flex: 1;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1f26;
}

.pool-meta {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
  padding-left: 60rpx;
}

/* ===== 待取餐：商户折叠 ===== */
.stall-list {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.stall-line {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.floor-chip {
  width: 52rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #1f9d55;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.stall-names {
  flex: 1;
  margin-left: 14rpx;
  font-size: 26rpx;
  color: #3d424a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stall-count {
  font-size: 22rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.more-line {
  font-size: 22rpx;
  color: #6b7280;
  padding: 6rpx 0 2rpx 66rpx;
}

/* ===== 已完成 ===== */
.done-meta {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.done-orders {
  font-size: 26rpx;
  color: #3d424a;
  margin-right: 20rpx;
}

.done-earn {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff6a00;
}

.done-time {
  margin-left: auto;
  font-size: 22rpx;
}
