.hero {
  background: linear-gradient(135deg, #1f9d55 0%, #2bb96a 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-code {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin: 16rpx 0;
}

.hero-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-num.money {
  color: #ff6a00;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.progress-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 27rpx;
  border-bottom: 1rpx solid #f5f6f8;
}

.progress-line:last-child {
  border-bottom: none;
}

.mt8 { margin-top: 8rpx; }

.bind-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.bind-input {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}

.ph { color: #c9cdd4; }

.bind-btn {
  margin-left: 16rpx;
  background: #1f9d55;
  color: #fff;
  font-size: 27rpx;
  padding: 0 40rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
}

.rules {
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.9;
  padding: 8rpx 12rpx 40rpx;
}

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.mt16 { margin-top: 24rpx; }

.bar {
  height: 16rpx;
  background: #f0f1f3;
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 14rpx;
}

.bar-fill {
  height: 100%;
  background: #1f9d55;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.bar-fill.green2 {
  background: #2bb96a;
}

.bar-num {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
}
