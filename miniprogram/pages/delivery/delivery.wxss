.head-card {
  border-left: 8rpx solid #1f9d55;
}

.mt8 { margin-top: 8rpx; }

.remain {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6a00;
}

.deliver-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.deliver-row:last-child {
  border-bottom: none;
}

.room {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1f26;
}

.deliver-btn {
  background: #1f9d55;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  padding: 0 44rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  min-width: 150rpx;
  text-align: center;
}

.deliver-btn.disabled { background: #c9cdd4; }

/* 完成态 */
.done-card {
  text-align: center;
  padding: 60rpx 32rpx;
}

.done-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #e8f7ee;
  color: #1f9d55;
  font-size: 48rpx;
  font-weight: 700;
}

.done-title {
  font-size: 34rpx;
  font-weight: 600;
}

.done-btn {
  display: inline-block;
  margin-top: 32rpx;
  background: #1f9d55;
  color: #fff;
  font-size: 28rpx;
  padding: 0 44rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
}

/* 底部主按钮 */
.container { padding-bottom: 200rpx; }

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(16, 24, 40, 0.08);
}

.bottom-label {
  font-size: 30rpx;
  font-weight: 600;
}

.bottom-sub {
  font-size: 23rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.bottom-btn {
  min-width: 240rpx;
  text-align: center;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #1f9d55;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.bottom-btn.disabled { background: #c9cdd4; }

.error-card {
  background: #fdecec;
  color: #d93b3b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
